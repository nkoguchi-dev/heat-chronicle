FROM ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv

# Digest updates are reviewed by the existing weekly Docker Dependabot job.
FROM public.ecr.aws/lambda/python:3.15@sha256:9ccea91653eed7f28f53c6653ad8398b2096d63b4e8f57b128af1c137d7c2718 AS base

# AL2023 base images can lag published security fixes. Refresh packages at build
# time; record the resulting immutable application digest after every rebuild.
RUN dnf upgrade --refresh --releasever=latest -y && dnf clean all

FROM base AS builder

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
COPY pyproject.toml uv.lock .python-version ./
# Export only locked runtime dependencies; uv and dev tools stay in the builder.
RUN uv export --locked --no-dev --no-emit-project -o requirements.txt \
    && uv pip install --python /var/lang/bin/python --require-hashes --no-deps \
       -r requirements.txt --target /opt/python

# ---- Runtime ----
FROM base

# Copy dependencies
COPY --from=builder /opt/python ${LAMBDA_TASK_ROOT}

# pip is a build tool, not an application runtime dependency. Remove its vendored
# libraries and ensurepip's bundled installer from the final filesystem.
# RIE is only a local emulator. Lambda uses the unchanged AWS entrypoint
# with AWS_LAMBDA_RUNTIME_API and does not need this bundled Go executable.
RUN python -m pip uninstall -y pip \
    && python -c 'import ensurepip, pathlib, shutil; shutil.rmtree(pathlib.Path(ensurepip.__file__).parent)' \
    && rm /usr/local/bin/aws-lambda-rie

# Copy application code
COPY app/ ${LAMBDA_TASK_ROOT}/app/
COPY data/ ${LAMBDA_TASK_ROOT}/data/

# Lambda handler
CMD ["app.handler.handler"]
