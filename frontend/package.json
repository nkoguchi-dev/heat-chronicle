    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "//overrides": "nanoid(GHSA-2v37-7h3g-55p8)を3.3.17へ固定。詳細: Issue #88。postcss経由で通常解決されるnanoidが3.3.17以上になったら削除可。",
