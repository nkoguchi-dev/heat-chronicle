system_name       = "heat-chronicle"
environment       = "prod"
aws_region        = "ap-northeast-1"
github_repository = "nkoguchi-dev/heat-chronicle"
domain_name       = "heat-chronicle.koppepan.org"
hosted_zone_name  = "koppepan.org"

# Initial limits agreed in docs/API_PROTECTION.md. Verify shared account capacity first.
api_capacity = {
  stage_rate                  = 5
  stage_burst                 = 10
  fetch_month_rate            = 1
  fetch_month_burst           = 2
  lambda_reserved_concurrency = 5
}
